# Copy to .env and fill in. Every EXPO_PUBLIC_ value ships inside the app bundle: never put a
# secret here. Server-side secrets are set with `supabase secrets set` (see docs/SETUP.md).

# Required. Without them the app still boots, signed out, and breakdowns use offline steps.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional. Defaults to $EXPO_PUBLIC_SUPABASE_URL/functions/v1/break-task.
EXPO_PUBLIC_SUPABASE_EDGE_FUNCTION_URL=

# Optional. Monitoring is a no-op without a DSN.
EXPO_PUBLIC_SENTRY_DSN=

# Optional. Shows Google sign-in (development build only; Expo Go lacks the native module).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. "true" shows Sign in with Apple on iOS.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
