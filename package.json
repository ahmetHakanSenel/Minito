{
  "name": "minito",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "brand:assets": "npx -y deno run --no-lock --node-modules-dir=none --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net scripts/build-brand-assets.ts",
    "eval:ai": "npx -y deno run --no-lock --allow-net --allow-env --allow-read --allow-write scripts/eval.ts",
    "gen:types": "npx -y supabase@2 gen types typescript --db-url postgres://postgres:postgres@localhost:54329/minito_migrations_test --schema public > src/data/supabase/database.types.ts",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "test:edge": "npx -y deno test --no-lock --allow-read supabase/functions/ scripts/",
    "readme:art": "npx -y deno run --no-lock --node-modules-dir=none --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net scripts/readme-art/main.ts"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.86.0",
    "axios": "^1.7.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.7.1",
    "lucide-react-native": "^0.555.0",
    "nativewind": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.3.5",
    "react-native": "^0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "0.5.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/",
      "<rootDir>/scripts/"
    ]
  }
}
