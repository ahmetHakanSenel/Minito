{
  "name": "minito",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "brand:assets": "npx -y deno run --no-lock --node-modules-dir=none --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net scripts/build-brand-assets.ts",
    "eval:ai": "npx -y deno run --no-lock --allow-net --allow-env --allow-read --allow-write scripts/eval.ts",
    "gen:types": "npx -y supabase@2 gen types typescript --db-url postgres://postgres:postgres@localhost:54329/minito_migrations_test --schema public > src/data/supabase/database.types.ts",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "test:edge": "npx -y deno test --no-lock --allow-read supabase/functions/ scripts/",
    "readme:art": "npx -y deno run --no-lock --node-modules-dir=none --allow-read --allow-write --allow-env --allow-ffi --allow-sys --allow-net scripts/readme-art/main.ts"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.86.0",
    "axios": "^1.7.0",
    "expo": "^57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "lucide-react-native": "^0.555.0",
    "nativewind": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/",
      "<rootDir>/scripts/"
    ]
  }
}
